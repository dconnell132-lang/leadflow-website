# Public URL of the separate LeadFlow SaaS application. This is the app's own
# subdomain — NOT theleadflowpros.com, which is this marketing site.
VITE_LEADFLOW_APP_URL=https://app.theleadflowpros.com

# Public base URL for future browser-safe API requests. Never place secrets here.
VITE_LEADFLOW_API_URL=https://app.theleadflowpros.com/api

# Both are baked into the bundle at build time. Setting them in the Cloudflare
# Pages dashboard has no effect until the site is rebuilt.
